# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---- Business calendar ----
# The timezone the books are kept in. Every "is this voucher back- or
# future-dated?" decision is made against the calendar date in THIS zone, not
# the server's UTC date — otherwise a voucher posted at 3am in Dhaka (UTC+6)
# would be judged against yesterday's UTC date and refused as future-dated.
BUSINESS_TIMEZONE=Asia/Dhaka

# ---- Application identity ----
# Lowercase, URL/filename-safe slug used to build default DB name, JWT
# issuer/audience, health-check service id, and backup filenames. Override
# per deployment; does not affect the company branding shown to end users
# (that is configured at runtime via Company Settings).
APP_SLUG=erp

# ---- Database (MySQL 8) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=0000
DB_NAME=erp_db
DB_CONNECTION_LIMIT=10

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars________
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_______
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Email OTP password recovery ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=Trip Fly BD <info@tripflybd.com>
BCRYPT_ROUNDS=10
# Optional overrides; default to `${APP_SLUG}-api` / `${APP_SLUG}`.
# JWT_ISSUER=erp-api
# JWT_AUDIENCE=erp

# ---- Abuse protection ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
