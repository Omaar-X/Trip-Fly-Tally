# Railway backend service variables.
NODE_ENV=production
PORT=4000

# Lowercase, URL/filename-safe slug used to build default DB name, JWT
# issuer/audience, health-check service id, and backup filenames.
APP_SLUG=erp

# Set this to your Vercel production URL and any preview/custom domains that should call the API.
CORS_ORIGIN=https://your-frontend.vercel.app,https://erp.yourdomain.com

# Railway MySQL can provide either DATABASE_URL/MYSQL_URL or the MYSQL* variables.
# Prefer DATABASE_URL when available; otherwise set MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
DB_CONNECTION_LIMIT=20

# Generate each secret independently with at least 32 random characters.
JWT_ACCESS_SECRET=replace_with_64_plus_random_chars
JWT_REFRESH_SECRET=replace_with_a_different_64_plus_random_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Email OTP password recovery ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=Trip Fly BD <info@tripflybd.com>
BCRYPT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
